NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=

SHOPIFY_CLIENT_ID=

SHOPIFY_CLIENT_SECRET=

SHOPIFY_APP_URL=

SHOPIFY_SCOPES=

SHOPIFY_API_VERSION=

SHOPIFY_TOKEN_ENCRYPTION_KEY=

SUPABASE_SECRET_KEY=

# Google Drive (server-only; never NEXT_PUBLIC_). See docs/google-drive-setup.md
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Must be exactly <your app URL>/api/google/callback (also registered in Google Cloud)
GOOGLE_REDIRECT_URI=

# Exactly one of: drive.readonly (recommended) or drive.file
GOOGLE_DRIVE_SCOPES=

# 32 random bytes, base64 (openssl rand -base64 32). Separate from the Shopify key.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional (development): extra hostnames allowed to load the dev server, comma-separated
ALLOWED_DEV_ORIGINS=

# Optional: show temporary development tools (e.g. Product Search Test) in production builds
SHOW_DEV_TOOLS=
