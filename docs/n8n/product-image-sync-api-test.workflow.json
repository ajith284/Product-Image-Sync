        "jsCode": "// Never logs or returns credentials: only the API response body is read.\nconst r = $input.first().json;\nconst status = Number(r.statusCode);\nlet body = r.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nbody = body || {};\nconst headers = r.headers || {};\nif (!(status >= 200 && status < 300)) {\n  const e = body.error || {};\n  const extra = e.active_job_id ? ` (active job ${e.active_job_id})` : '';\n  throw new Error(`Store Status failed: HTTP ${status}` + (e.code ? ` ${e.code}: ${e.message}${extra} [request_id ${e.request_id}]` : ''));\n}\n\nconst shopify = body.shopify || {};\nconst drive = body.google_drive || {};\nreturn [{ json: {\n  store_id: body.store_id,\n  store_name: body.store_name,\n  shopify_connected: shopify.connected === true,\n  google_drive_connected: drive.connected === true,\n  root_folder_selected: drive.root_folder_selected === true,\n  root_folder_name: drive.root_folder_name || null,\n  ready_for_sync: body.ready_for_sync === true,\n} }];\n"
