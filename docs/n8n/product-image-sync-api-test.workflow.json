{
  "name": "Product Image Sync API Test",
  "nodes": [
    {
      "parameters": {},
      "id": "6f1d1a10-0001-4a00-9000-000000000001",
      "name": "Run test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "baseUrl", "value": "https://YOUR-APP-DOMAIN/api/n8n/v1", "type": "string" },
            { "id": "a2", "name": "storeId", "value": "YOUR-STORE-ID", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "6f1d1a10-0001-4a00-9000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.baseUrl }}/health",
        "options": {}
      },
      "id": "6f1d1a10-0001-4a00-9000-000000000003",
      "name": "1 Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.baseUrl }}/stores/{{ $('Config').item.json.storeId }}/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Request-ID", "value": "=n8n-{{ $execution.id }}-status" }] },
        "options": {}
      },
      "id": "6f1d1a10-0001-4a00-9000-000000000004",
      "name": "2 Store status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.baseUrl }}/sync-jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Idempotency-Key", "value": "=n8n-{{ $execution.id }}-create" },
            { "name": "X-Request-ID", "value": "=n8n-{{ $execution.id }}-create" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ store_id: $('Config').item.json.storeId, trigger_source: 'n8n', dry_run: true }) }}",
        "options": {}
      },
      "id": "6f1d1a10-0001-4a00-9000-000000000005",
      "name": "3 Create sync job (queue only)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.baseUrl }}/sync-jobs/{{ $json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Request-ID", "value": "=n8n-{{ $execution.id }}-get" }] },
        "options": {}
      },
      "id": "6f1d1a10-0001-4a00-9000-000000000006",
      "name": "4 Get sync job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0]
    }
  ],
  "connections": {
    "Run test": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "1 Health", "type": "main", "index": 0 }]] },
    "1 Health": { "main": [[{ "node": "2 Store status", "type": "main", "index": 0 }]] },
    "2 Store status": { "main": [[{ "node": "3 Create sync job (queue only)", "type": "main", "index": 0 }]] },
    "3 Create sync job (queue only)": { "main": [[{ "node": "4 Get sync job", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
